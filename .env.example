# 英语学习助手 · 环境变量配置
# 复制此文件为 .env 并填入你的配置

# 数据库（⚠️ 必须用 Neon Pooler URL，否则 Serverless 会爆连接数）
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/dbname?sslmode=require"

# AI API（至少填一个）
DEEPSEEK_API_KEY=sk-...
# MIMO_API_KEY=...
# OPENAI_API_KEY=...

# 登录密码
AUTH_PASSWORD=your_password_here

# JWT 密钥（用 openssl rand -hex 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成）
JWT_SECRET=replace_with_random_32_byte_hex
